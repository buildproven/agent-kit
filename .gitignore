# Dependencies
node_modules/

# Release artifacts
.scrub.log

# Local settings (root level only)
/settings.local.json

# Allow config/settings.json (the source of truth)
!config/settings.json

# Logs and temp files
*.log
.DS_Store

# Sensitive data
*secret*
*_token*
*-token*
*.token
*key*
!skills/**/keyword*
.env

# Session-specific files (don't share across computers)
debug/
file-history/
history.jsonl
shell-snapshots/
todos/
projects/
.update_check

# HUD state written by scripts/hud-update.sh. Generated per checkout, so
# leaving it untracked makes every quality gate in that worktree fail the
# clean-tree precondition and report it as "gate:lint failed".
.claude/hud-state.json

# Cost tracking (personal usage data)
.claude/cost-tracking.json
cost-tracking.json

# Backups
*.backup
BACKLOG.md.ralph-next-backup
BACKLOG.md.ralph-next-backup-*

# Claude Code worktrees (transient parallel-agent artifacts)
.claude/worktrees/

# Agent scratch space. Sessions are told to put temp files here instead of
# /tmp, and test suites that set TMPDIR leak their mkdtemp trees into it. It is
# never repository content, and untracked fixtures under it otherwise get
# scored, linted, and formatted as if they were.
scratchpad/

# Session artifacts (transient — not shared across machines)
.playwright-mcp/
.claude/ralph-next/quality-*.json
.claude/ralph-next/evidence/

# Quality telemetry — the recorder defaults to <repo>/data/*.jsonl when quality
# runs on THIS repo. In a public repo those must never be committed (an overlay
# that WANTS committed history sets BS_QUALITY_TELEMETRY_FILE to a tracked path).
data/quality-telemetry.jsonl
data/quality-escapes.jsonl
data/quality-value-report.md

# Claude Code statsig cache
statsig/
config/social-credentials.env
mcp-servers/*/node_modules/
mcp-servers/*/dist/
mcp-servers/*/.env
docs/node_modules/
__pycache__/
.pytest_cache/
.serena/

coverage/
reports/

# License files (never commit actual licenses)
data/licenses/*.json

# SOTA assessment artifacts (generated, machine-local)
.claude/sota-history.json
data/sota-history.json
data/sota-report.md
