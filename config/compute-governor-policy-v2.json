{
  "schemaVersion": 2,
  "policyVersion": "2026-09-23-static-task-v2",
  "executionProfile": {
    "version": "codex-isolated-v1",
    "approval": "never",
    "externalTools": false,
    "extraWritableRoots": false
  },
  "callers": {
    "overnight-ralph": {
      "phases": ["implement"],
      "maxAccess": "workspace-write"
    },
    "interactive-ralph": {
      "phases": [
        "scan",
        "plan",
        "implement",
        "verify",
        "remediate",
        "diagnose"
      ],
      "maxAccess": "workspace-write"
    },
    "fleet-steward": {
      "phases": ["implement", "remediate", "diagnose"],
      "maxAccess": "workspace-write"
    },
    "cross-review": {
      "phases": ["scan", "review"],
      "maxAccess": "read-only"
    }
  },
  "routes": {
    "economy-micro": {
      "caps": { "maxWallSeconds": 300, "maxWorkers": 1 },
      "model": "gpt-5.6-luna",
      "effort": "medium"
    },
    "economy-builder": {
      "caps": { "maxWallSeconds": 900, "maxWorkers": 1 },
      "model": "gpt-5.6-luna",
      "effort": "medium"
    },
    "standard": {
      "caps": { "maxWallSeconds": 1800, "maxWorkers": 1 },
      "model": "gpt-5.6-terra",
      "effort": "medium"
    },
    "expert": {
      "caps": { "maxWallSeconds": 2700, "maxWorkers": 1 },
      "model": "gpt-5.6-terra",
      "effort": "high"
    },
    "critical": {
      "caps": { "maxWallSeconds": 3600, "maxWorkers": 1 },
      "model": "gpt-5.6-sol",
      "effort": "high"
    }
  },
  "protectedSurfaces": [
    "auth",
    "authorization",
    "payments",
    "durable-data",
    "migration",
    "public-contract",
    "deployment",
    "security",
    "cross-repository"
  ],
  "protectedPathRules": {
    "auth": ["auth/", "authentication/", "login/"],
    "authorization": ["authorization/", "permissions/", "roles/"],
    "payments": ["payments/", "billing/", "stripe/"],
    "durable-data": ["data/", "database/", "storage/"],
    "migration": ["migrations/", "schema/"],
    "public-contract": ["api/", "cli/", "sdk/"],
    "deployment": [".github/workflows/", "deploy/", "infrastructure/"],
    "security": [
      "AGENTS.md",
      "CLAUDE.md",
      "SKILL.md",
      "commands/",
      "skills/",
      ".claude/",
      ".codex/",
      ".agents/",
      "policies/",
      "docs/decisions/",
      "security/",
      "secrets/",
      "scripts/compute-governor.js",
      "scripts/provider-run.sh",
      "scripts/provider-policy.sh",
      "scripts/run-with-deadline.py",
      "scripts/quality-provider-error.js",
      "scripts/quality-provider-usage.js",
      "scripts/autonomous-loop-runtime.js",
      "scripts/overnight-loop.sh",
      "scripts/steward/orchestrate.sh",
      "skills/ralph/reference.md",
      "skills/cross-review/SKILL.md",
      "config/compute-governor-policy-v1.json",
      "config/compute-governor-policy-v2.json"
    ],
    "cross-repository": [".gitmodules"]
  },
  "protectedPromptPatterns": {
    "auth": [
      "\\bauth(?:entication)?\\b",
      "\\blogin\\b",
      "\\bpassword(?:s)?\\b",
      "\\bsign[ -]?in\\b",
      "\\boauth\\b",
      "\\bsession\\b"
    ],
    "authorization": [
      "\\bauthori[sz](?:e|ation)\\b",
      "\\baccess control\\b",
      "\\bpermission(?:s)?\\b",
      "\\brole(?:s)?\\b"
    ],
    "payments": [
      "\\bpayment(?:s)?\\b",
      "\\bstripe\\b",
      "\\bbilling\\b",
      "\\bcheckout\\b",
      "\\bsubscription(?:s)?\\b"
    ],
    "durable-data": [
      "\\bdatabase\\b",
      "\\bpersist(?:ence|ent|ed)?\\b",
      "\\bdurable data\\b",
      "\\bqueue database\\b"
    ],
    "migration": ["\\bmigration(?:s)?\\b", "\\bschema change\\b"],
    "public-contract": [
      "\\bpublic api\\b",
      "\\bsdk\\b",
      "\\bcli contract\\b",
      "\\bpublished package\\b"
    ],
    "deployment": [
      "\\bdeploy(?:ment|ing)?\\b",
      "\\bproduction\\b",
      "\\brelease workflow\\b"
    ],
    "security": [
      "\\bsecurity\\b",
      "\\bsecret(?:s)?\\b",
      "\\bcredential(?:s)?\\b",
      "\\bvulnerabilit(?:y|ies)\\b",
      "\\bsandbox(?:ing)?\\b",
      "\\bmodel rout(?:e|er|ing)\\b",
      "\\bcompute governor\\b",
      "\\bprovider runner\\b"
    ],
    "cross-repository": [
      "\\bcross[- ]repo(?:sitory)?\\b",
      "\\bsubmodule\\b",
      "\\bmultiple repositories\\b"
    ]
  },
  "specializedExemptions": ["quality-panel", "strategy-ensemble"]
}
