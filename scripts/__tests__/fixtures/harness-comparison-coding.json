    {
      "id": "T01",
      "prompt": "Fix cli.cjs so --name requires a non-empty value. Missing or empty values must exit 2, write 'name requires a value\\n' to stderr, and print nothing to stdout. Keep --dry-run boolean: it prints 'dry-run\\n'. A valid --name Ada prints 'Hello Ada\\n'; --name Ada --dry-run prints 'dry-run\\n'. Add regression.cjs, runnable with node, that fails on the original missing-value bug. Change only cli.cjs and regression.cjs.",
      "files": {
        "cli.cjs": "const a=process.argv.slice(2);const i=a.indexOf('--name');const name=i<0?'world':a[i+1].trim();console.log(a.includes('--dry-run')?'dry-run':`Hello ${name}`);\n"
      },
      "solution": {
        "cli.cjs": "const a=process.argv.slice(2);const i=a.indexOf('--name');if(i>=0&&(!a[i+1]||a[i+1].startsWith('--')||!a[i+1].trim())){console.error('name requires a value');process.exit(2)}const name=i<0?'world':a[i+1].trim();console.log(a.includes('--dry-run')?'dry-run':`Hello ${name}`);\n",
        "regression.cjs": "const a=require('node:assert/strict');const{spawnSync}=require('node:child_process');const r=spawnSync(process.execPath,['cli.cjs','--name'],{encoding:'utf8'});a.equal(r.status,2);a.equal(r.stderr,'name requires a value\\n');\n"
      },
      "checks": [
        {
          "args": ["--name"],
          "status": 2,
          "stdout": "",
          "stderr": "name requires a value\n"
        },
        {
          "args": ["--name", ""],
          "status": 2,
          "stdout": "",
          "stderr": "name requires a value\n"
        },
        {
          "args": ["--name", "--dry-run"],
          "status": 2,
          "stdout": "",
          "stderr": "name requires a value\n"
        },
        {
          "args": ["--name", "Ada"],
          "stdout": "Hello Ada\n"
        },
        {
          "args": ["--dry-run"],
          "stdout": "dry-run\n"
        },
        {
          "args": ["--name", "Ada", "--dry-run"],
          "stdout": "dry-run\n"
        }
      ],
      "regression": "regression.cjs",
      "mutationPath": "cli.cjs",
      "permittedPaths": ["cli.cjs", "regression.cjs"]
    },
    {
      "id": "T02",
      "prompt": "Fix cli.cjs: node cli.cjs --check must print 'ready\\n', exit 0, and leave the filesystem unchanged. Normal node cli.cjs must still create output/result.txt containing 'ready\\n' and print 'written\\n'. Change only cli.cjs.",
      "files": {
        "cli.cjs": "const fs=require('node:fs');fs.mkdirSync('output',{recursive:true});if(process.argv.includes('--check')){console.log('ready')}else{fs.writeFileSync('output/result.txt','ready\\n');console.log('written')}\n"
      },
      "solution": {
        "cli.cjs": "const fs=require('node:fs');if(process.argv.includes('--check')){console.log('ready')}else{fs.mkdirSync('output',{recursive:true});fs.writeFileSync('output/result.txt','ready\\n');console.log('written')}\n"
