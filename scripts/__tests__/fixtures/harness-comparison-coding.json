        {
          "args": ["--json", "--fail"],
          "status": 1,
          "stdout": "{\"status\":\"unavailable\"}\n",
          "stderr": "unavailable\n"
        }
      ],
      "permittedPaths": ["cli.cjs"]
    },
    {
      "id": "T04",
      "prompt": "cli.cjs reads a JSON array of {name,group} objects from stdin and returns the names as a JSON array plus newline. Add optional --group VALUE that returns names only for the matching group, preserving input order. Without --group retain all names. Empty or nonmatching input returns []. Change only cli.cjs.",
      "files": {
        "cli.cjs": "const fs=require('node:fs');const rows=JSON.parse(fs.readFileSync(0,'utf8'));console.log(JSON.stringify(rows.map(x=>x.name)));\n"
      },
      "solution": {
        "cli.cjs": "const fs=require('node:fs');const rows=JSON.parse(fs.readFileSync(0,'utf8'));const i=process.argv.indexOf('--group');const filtered=i<0?rows:rows.filter(x=>x.group===process.argv[i+1]);console.log(JSON.stringify(filtered.map(x=>x.name)));\n"
      },
      "checks": [
        {
          "args": [],
          "input": "[{\"name\":\"A\",\"group\":\"x\"},{\"name\":\"B\",\"group\":\"y\"},{\"name\":\"C\",\"group\":\"x\"}]",
          "stdout": "[\"A\",\"B\",\"C\"]\n"
        },
        {
          "args": ["--group", "x"],
          "input": "[{\"name\":\"A\",\"group\":\"x\"},{\"name\":\"B\",\"group\":\"y\"},{\"name\":\"C\",\"group\":\"x\"}]",
          "stdout": "[\"A\",\"C\"]\n"
        },
        {
          "args": ["--group", "z"],
          "input": "[{\"name\":\"A\",\"group\":\"x\"}]",
          "stdout": "[]\n"
        },
        {
          "args": ["--group", "x"],
          "input": "[]",
          "stdout": "[]\n"
        }
      ],
      "permittedPaths": ["cli.cjs"]
    },
