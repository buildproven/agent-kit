    {
      "id": "T03",
      "prompt": "Add --json to cli.cjs. Normal text output remains 'ready\\n', status 0. --json prints exactly {\"status\":\"ready\"} plus newline. --fail exits 1 with no stdout and 'unavailable\\n' on stderr; --json --fail exits 1, prints exactly {\"status\":\"unavailable\"} plus newline on stdout and the same diagnostic on stderr. Change only cli.cjs.",
      "files": {
        "cli.cjs": "if(process.argv.includes('--fail')){console.error('unavailable');process.exit(1)}console.log('ready');\n"
      },
      "solution": {
        "cli.cjs": "const bad=process.argv.includes('--fail');if(process.argv.includes('--json'))console.log(JSON.stringify({status:bad?'unavailable':'ready'}));else if(!bad)console.log('ready');if(bad){console.error('unavailable');process.exitCode=1}\n"
      },
      "checks": [
